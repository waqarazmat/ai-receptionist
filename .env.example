# Retell voice — platform-level API key for Retell's management REST API,
# used to auto-provision agents (set their Custom LLM URL + webhook). Optional;
# without it, saving a Retell Agent ID still works but must be wired up by hand
# in Retell's dashboard.
RETELL_API_KEY=

# The backend's externally-reachable base origin (NO trailing slash). Must be a
# URL Retell can actually reach — an ngrok tunnel in dev, the Railway URL in
# prod — NOT localhost. Used to build the Custom LLM WebSocket URL and webhook
# URL pushed into Retell when provisioning an agent.
# Dev example: https://superaqual-changable-raymon.ngrok-free.dev
APP_PUBLIC_URL=http://localhost:8000
