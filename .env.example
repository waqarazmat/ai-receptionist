# ─────────────────────────────────────────────────────────────────────────────
# AI Receptionist — Environment Variables
# Copy this file to .env and fill in the values.
# Lines starting with # are comments. Remove the # to activate a variable.
# NEVER commit the real .env file — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:  postgresql+asyncpg://postgres:password@localhost:5432/ai_receptionist
# Railway:    copy the DATABASE_URL from your Railway Postgres service
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_receptionist

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev:  redis://localhost:6379/0
# Railway:    copy the REDIS_URL from your Railway Redis service
REDIS_URL=redis://localhost:6379/0

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-64-char-random-hex-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=replace-with-fernet-key

# ── Super admin ───────────────────────────────────────────────────────────────
# The email address used to log in as super admin (OTP will be sent here)
SUPER_ADMIN_EMAIL=your-email@example.com

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:5173"]

# The backend's externally-reachable base URL (no trailing slash).
# In dev: use an ngrok tunnel so Retell/WhatsApp webhooks can reach localhost.
# In prod: your Railway backend URL, e.g. https://ai-receptionist-prod.up.railway.app
APP_PUBLIC_URL=http://localhost:8000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Required for OTP delivery. Use any SMTP relay (Resend, Mailgun, Brevo, SES…)
# For quick local testing you can use Gmail SMTP with an App Password.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_api_key_here
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_FROM_NAME=AI Receptionist
SMTP_USE_TLS=true

# Optional second SMTP relay (failover). Leave blank to disable.
# SMTP_HOST_FALLBACK=
# SMTP_PORT_FALLBACK=587
# SMTP_USERNAME_FALLBACK=
# SMTP_PASSWORD_FALLBACK=
# SMTP_FROM_ADDRESS_FALLBACK=

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────────
# From Meta Developer Console → Your App → Settings → Basic
# WHATSAPP_APP_SECRET is the "App Secret" (NOT the access token).
# WHATSAPP_VERIFY_TOKEN is any random string you choose when setting up the webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0

# ── Retell (Voice) ────────────────────────────────────────────────────────────
# Platform-level Retell API key (from Retell dashboard → Settings → API Keys).
# Used to auto-provision agents. If blank, agent wiring must be done by hand.
RETELL_API_KEY=

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Platform-level OpenAI key — used for WhatsApp voice note STT + TTS.
# Per-org LLM keys (for the AI receptionist responses) are stored in the DB
# via the Setup Wizard, not here.
OPENAI_API_KEY=

# Groq API key — faster + cheaper STT alternative to OpenAI Whisper.
# Sign up free at console.groq.com. Set STT_PROVIDER=groq to use it.
GROQ_API_KEY=

# STT provider: "groq" (default, faster) or "openai"
STT_PROVIDER=groq
# TTS provider: "openai" (default) or "deepgram"
TTS_PROVIDER=openai

# Deepgram API key — only needed if TTS_PROVIDER=deepgram
# DEEPGRAM_API_KEY=

# ── Google Calendar ───────────────────────────────────────────────────────────
# Path to a Google service account JSON key file.
# Each org shares their calendar with this service account's client_email.
# Leave blank to disable calendar features.
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# ── Web scraping (optional) ───────────────────────────────────────────────────
# Firecrawl API key for enhanced website crawling in the knowledge base builder.
# Without it, the crawler falls back to httpx + BeautifulSoup (good enough for most sites).
# FIRECRAWL_API_KEY=

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Sentry DSN — leave blank in dev, set on Railway in production.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Slack or Discord incoming webhook URL for critical alert notifications.
# ALERT_WEBHOOK_URL=
